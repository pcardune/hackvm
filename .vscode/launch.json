  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'hackvm'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=hackvm"
        ],
        "filter": {
          "name": "hackvm",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug benchmark 'my_benchmark'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bench=my_benchmark",
          "--package=hackvm"
        ],
        "filter": {
          "name": "my_benchmark",
          "kind": "bench"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'hackc'",
      "cargo": {
        "args": [
          "build",
          "--bin=hackc",
          "--package=hackc"
        ],
        "filter": {
          "name": "hackc",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'hackc'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bin=hackc",
          "--package=hackc"
        ],
        "filter": {
          "name": "hackc",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'fun'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=fun"
        ],
        "filter": {
          "name": "fun",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}